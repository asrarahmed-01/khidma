# Postgres from docker-compose.yml in the repo root
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/khidma"

PORT=4000

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"
OTP_SECRET="replace-with-another-long-random-string-32-chars"

JWT_EXPIRES_IN="7d"

# OTP rules: 5-minute codes, 5 guesses per code, 3 codes per 10 minutes per number
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS=3
OTP_REQUEST_WINDOW_SECONDS=600

# Comma-separated list in production, e.g. https://admin.khidma.app
CORS_ORIGINS="*"

# Public address of this API, used for the payment return link. Leave empty in development:
# the API then uses whatever address the app called (e.g. http://192.168.1.5:4000).
PUBLIC_API_URL=""

# Moyasar payments (https://dashboard.moyasar.com, test mode → Settings → API keys).
# Leave empty to use the built-in simulated checkout, which works without an account.
MOYASAR_SECRET_KEY=""
# Pick any long random string and enter the same value as the webhook's secret token in
# the Moyasar dashboard (Settings → Webhooks, URL: <PUBLIC_API_URL>/payments/moyasar/webhook).
MOYASAR_WEBHOOK_SECRET=""

# Push notifications go through Expo's push service. Set PUSH_ENABLED=false to print them
# in this console instead. EXPO_ACCESS_TOKEN is only needed if you turn on "enhanced push
# security" in the Expo dashboard.
PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=""
