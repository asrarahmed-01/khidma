# Copy to .env (Expo loads it automatically). EXPO_PUBLIC_ values are bundled into the app,
# so only put public values here.

# Optional: where the API is. Leave unset in development: the app uses your computer's
# address from the Expo dev server, port 4000.
# EXPO_PUBLIC_API_URL=https://khidma-api.example.com

# Mapbox public token (starts with pk.), from https://account.mapbox.com/access-tokens/
# Without it the tracking screen shows a simple direction-and-distance diagram.
EXPO_PUBLIC_MAPBOX_TOKEN=
