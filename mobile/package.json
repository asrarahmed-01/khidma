{
  "name": "khidma-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Khidma mobile app for customers and technicians (React Native, Expo)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "export:web": "expo export --platform web",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans-arabic": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@rnmapbox/maps": "^10.3.10",
    "@tanstack/react-query": "^5.104.4",
    "expo": "~57.0.30",
    "expo-asset": "~57.0.20",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.5.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.1.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.4",
    "socket.io-client": "^4.8.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
